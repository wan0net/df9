{
  "name": "spacebase-df9",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:reverse-shards": "node scripts/run-e2e-reverse-shards.mjs",
    "test:e2e:ci": "PLAYWRIGHT_JSON_OUTPUT_NAME=playwright-results.json playwright test --reporter=json && node scripts/assert-playwright-skips.mjs playwright-results.json",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "three": "^0.172.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.172.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
